@using RealEstateApp.Core.Application.Dtos.Account
@using RealEstateApp.Core.Application.Helpers
@inject IHttpContextAccessor httpContextAccessor
@{
    var User = httpContextAccessor.HttpContext.Session.Get<AuthenticationResponse>("user");
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEstateApp</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealEstateApp.WebApp.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" />
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8f9fa;
        }

        .sidebar {
            width: 280px;
            height: 100vh;
            position: fixed;
            background-color: #343a40;
            padding: 20px;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

            .sidebar a {
                color: white;
                text-decoration: none;
            }

            .sidebar .nav-link {
                padding: 10px;
                border-radius: 5px;
            }

                .sidebar .nav-link:hover {
                    background-color: #495057;
                }

        .user-info {
            text-align: center;
            margin-bottom: 20px;
        }

        .logout-btn {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            width: 80%;
        }

        .main-content {
            margin-left: 300px;
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="d-flex">
        <div class="sidebar">
            <div>
                <h4 class="text-center">Real Estate APP</h4>
                <hr>
                <div class="user-info">
                    <p>Bienvenido, <strong>@User.UserName</strong></p>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Admin" asp-action="Index"><i class="fa-solid fa-house"></i> Home</a>
                    </li>
                    <hr>
                    <li class="nav-item"><strong>Usuarios</strong></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="AgentManagement"><i class="fa-solid fa-user"></i> Agentes</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="AdminManagement"><i class="fa-solid fa-user-tie"></i> Administradores</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="User" asp-action="DevManagement"><i class="fa-solid fa-user-gear"></i> Desarrolladores</a>
                    </li>
                    <hr>
                    <li class="nav-item"><strong>Propiedades</strong></li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Improvement" asp-action="Index"><i class="bi bi-house-gear-fill"></i> Mejoras</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="SaleType" asp-action="Index"><i class="fa-solid fa-file-invoice-dollar"></i> Tipos de ventas</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="PropertyType" asp-action="Index"><i class="fa-solid fa-city"></i> Tipos de propiedades</a>
                    </li>
                </ul>
            </div>
            <a asp-controller="Auth" asp-action="LogOut" class="btn btn-danger logout-btn">Cerrar sesión</a>
        </div>
        <div class="main-content container-fluid">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
