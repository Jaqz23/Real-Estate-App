@model RealEstateApp.Core.Application.ViewModels.Property.PropertyDetailsViewModel

@{
    ViewData["Title"] = "Property Details";
}

<div class="container mt-5">
    <div class="row g-4">
        <!-- Slider -->
        <div class="col-md-8">
            <div id="propertyImageSlider" class="carousel slide rounded shadow-sm overflow-hidden" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @if (!string.IsNullOrEmpty(Model.ImgUrl1))
                    {
                        <div class="carousel-item active">
                            <img src="@Model.ImgUrl1" class="d-block w-100" alt="Property Image 1">
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ImgUrl2))
                    {
                        <div class="carousel-item">
                            <img src="@Model.ImgUrl2" class="d-block w-100" alt="Property Image 2">
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ImgUrl3))
                    {
                        <div class="carousel-item">
                            <img src="@Model.ImgUrl3" class="d-block w-100" alt="Property Image 3">
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.ImgUrl4))
                    {
                        <div class="carousel-item">
                            <img src="@Model.ImgUrl4" class="d-block w-100" alt="Property Image 4">
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#propertyImageSlider" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#propertyImageSlider" data-bs-slide="next">
                    <span class="carousel-control-next-icon bg-dark rounded-circle p-2" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Property details -->
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h3 class="text-primary mb-3">@Model.PropertyType</h3>
                <hr>

                <div class="mb-2"><strong>Código de Propiedad:</strong> <span class="text-muted">@Model.Code</span></div>
                <div class="mb-2"><strong>Tipo de Venta:</strong> <span class="text-muted">@Model.SalesType</span></div>
                <div class="mb-2"><strong>Precio:</strong> <span class="text-success fw-bold">@string.Format("DOP{0:C}", Model.Price)</span></div>
                <div class="mb-2"><strong>Habitaciones:</strong> <span class="text-muted">@Model.NumberOfRooms</span></div>
                <div class="mb-2"><strong>Baños:</strong> <span class="text-muted">@Model.NumberOfBathrooms</span></div>
                <div class="mb-2"><strong>Tamaño del terreno (m²):</strong> <span class="text-muted">@Model.LandSize</span></div>

                <div class="mt-3">
                    <strong>Descripción:</strong>
                    <p class="text-muted">@Model.Description</p>
                </div>

                <div class="mt-3">
                    <strong>Mejoras:</strong><br />
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        @foreach (var improvement in Model.ImproveMentes)
                        {
                            <span class="badge bg-primary-subtle text-primary border border-primary rounded-pill px-3 py-2">@improvement.Name</span>
                        }
                    </div>
                </div>

                <hr class="my-4" />

                <!-- Agent information -->
                <div class="text-center">
                    <h5 class="text-secondary mb-3">Agente Inmobiliario</h5>
                    <img src="@Model.AgentImgUrl" alt="Agent Image" class="img-fluid rounded-circle mb-3 shadow-sm" style="width: 120px; height: 120px; object-fit: cover;">
                    <p class="mb-1"><strong>@Model.AgentName</strong></p>
                    <p class="mb-1"><i class="bi bi-telephone"></i> @Model.AgentPhoneNumber</p>
                    <p><i class="bi bi-envelope"></i> @Model.AgentEmail</p>
                </div>
            </div>
        </div>
    </div>
</div>
