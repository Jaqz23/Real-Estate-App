@model List<RealEstateApp.Core.Application.ViewModels.Property.PropertyViewModel>

<div class="container-fluid px-4">
    <!-- Cabecera -->
    <div class="card border mt-4 shadow-sm px-4 py-3 mb-4">
        <div class="row justify-content-between align-items-center">
            <div class="col-md-6">
                <h4 class="mb-0">📌 Propiedades guardadas</h4>
            </div>
            <div class="col-md-6 text-md-end mt-3 mt-md-0">
                <a asp-action="Create" asp-controller="Property" class="btn btn-dark">
                    <i class="fa-solid fa-plus me-2"></i>Registrar nueva propiedad
                </a>
            </div>
        </div>
    </div>

    <!-- Listado de propiedades -->
    <div class="container mt-4">
        @if (Model == null || Model.Count == 0)
        {
            <h4 class="text-center mt-5">No hay propiedades guardadas</h4>
        }
        else
        {
            <div class="row g-4">
                @foreach (var propiedad in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm border-0">
                            <a class="text-decoration-none text-dark" asp-controller="Home" asp-action="Details" asp-route-id="@propiedad.Id">
                                <div class="position-relative">
                                    <img class="card-img-top" src="@propiedad.ImagesUrl.FirstOrDefault()" alt="Imagen propiedad" style="height: 220px; object-fit: cover;">
                                    <span class="badge bg-primary position-absolute top-0 end-0 m-2">Cod. @propiedad.Code</span>
                                </div>
                                <div class="card-body">
                                    <h5 class="card-title">@propiedad.PropertyType</h5>
                                    <p class="mb-2 text-muted">@propiedad.SaleType.ToUpper()</p>
                                    <p class="fw-bold fs-5 mb-0">@string.Format("DOP{0:C}", propiedad.Price)</p>
                                </div>
                            </a>
                            <div class="card-footer bg-white border-top">
                                <div class="d-flex justify-content-between text-center small">
                                    <div>
                                        <i class="fas fa-bath me-1"></i> @propiedad.NumberOfBathrooms <br> <span class="text-muted">Baños</span>
                                    </div>
                                    <div>
                                        <i class="fas fa-door-closed me-1"></i> @propiedad.NumberOfRooms <br> <span class="text-muted">Habitaciones</span>
                                    </div>
                                    <div>
                                        <i class="fas fa-expand-arrows-alt me-1"></i> @propiedad.LandSize m² <br> <span class="text-muted">Área</span>
                                    </div>
                                </div>
                            </div>

                            <div class="card-footer bg-light border-top d-flex justify-content-around py-3">
                                <a class="btn btn-outline-primary btn-sm" asp-controller="Property" asp-action="Edit" asp-route-id="@propiedad.Id">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>Editar
                                </a>
                                <a class="btn btn-outline-danger btn-sm" asp-controller="Property" asp-action="Delete" asp-route-id="@propiedad.Id">
                                    <i class="fa-solid fa-trash me-1"></i>Eliminar
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
